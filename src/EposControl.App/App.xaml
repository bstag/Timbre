<Application x:Class="EposControl.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#E8EDF5"/><SolidColorBrush x:Key="MutedInk" Color="#A8B5C8"/>
    <SolidColorBrush x:Key="Surface" Color="#182334"/><SolidColorBrush x:Key="Accent" Color="#63DBC5"/>
    <Geometry x:Key="MicIcon">M 8,1 C 4,1 4,5 4,8 C 4,12 12,12 12,8 L 12,5 C 12,1 8,1 8,1 M 1,8 C 1,18 15,18 15,8 M 8,16 L 8,20 M 4,20 L 12,20</Geometry>
    <Geometry x:Key="GateIcon">M 1,17 L 5,17 5,3 15,3 15,17 19,17 M 9,7 L 11,7 M 9,11 L 11,11</Geometry>
    <Geometry x:Key="FilterIcon">M 1,2 L 19,2 12,10 12,18 8,18 8,10 Z</Geometry>
    <Geometry x:Key="HighPassIcon">M 1,17 L 6,17 C 10,17 10,3 14,3 L 19,3</Geometry>
    <Geometry x:Key="EqIcon">M 3,1 L 3,19 M 10,1 L 10,19 M 17,1 L 17,19 M 0,6 L 6,6 M 7,14 L 13,14 M 14,9 L 20,9</Geometry>
    <Geometry x:Key="HeadphoneIcon">M 2,14 L 2,9 C 2,-1 18,-1 18,9 L 18,14 M 2,10 L 5,10 5,18 2,18 Z M 15,10 L 18,10 18,18 15,18 Z</Geometry>
    <Geometry x:Key="DiagnosticsIcon">M 4,21 L 4,2 12,2 17,7 17,11 M 12,2 L 12,7 17,7 M 7,11 L 12,11 M 7,15 L 11,15 M 7,19 L 10,19 M 17,14 L 17,22 M 13,18 L 17,22 21,18</Geometry>
    <Geometry x:Key="RefreshIcon">M 18,7 C 15,2 8,2 5,6 C 1,11 3,18 8,20 C 13,22 18,19 20,15 M 18,2 L 18,8 12,8</Geometry>
    <Geometry x:Key="ReverbIcon">M 1,7 L 1,13 5,13 9,17 9,3 5,7 Z M 12,6 C 16,8 16,12 12,14 M 16,3 C 22,7 22,13 16,17</Geometry>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#203045"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#34475F"/>
      <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#263A50"/><Setter Property="BorderBrush" Value="#496176"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#2B4C56"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderIconButton" TargetType="Button">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#142033"/><Setter Property="BorderBrush" Value="#2B3B50"/>
      <Setter Property="Foreground" Value="{StaticResource MutedInk}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
          <Path Data="{TemplateBinding Tag}" Width="16" Height="16" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#203045"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#496176"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#2B4C56"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,1">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#293E54"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#304D61"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#203045"/><Setter Property="BorderBrush" Value="#34475F"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid SnapsToDevicePixels="True">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
          <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                <Path x:Name="Chevron" Data="M 0,0 L 4,4 8,0" Stroke="{StaticResource MutedInk}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFrame" Property="Background" Value="#263A50"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter><Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Accent}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
          <Border x:Name="FocusFrame" Grid.ColumnSpan="2" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
            <Border Background="{StaticResource Surface}" BorderBrush="#496176" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusFrame" Property="BorderBrush" Value="#496176"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="FocusFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#203045"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#34475F"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionBrush" Value="#304D61"/>
      <Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#496176"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="EffectSwitch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="32"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="SwitchFrame" Background="#203045" BorderBrush="#34475F" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal">
            <Grid Width="18" Height="18" Margin="0,0,6,0">
              <Path x:Name="Symbol" Data="{TemplateBinding Tag}" Stroke="{StaticResource MutedInk}" StrokeThickness="1.8" Stretch="Uniform" Margin="2"/>
              <Path x:Name="OffSlash" Data="M 1,17 L 17,1" Stroke="#FF747C" StrokeThickness="2.2"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="OffSlash" Property="Visibility" Value="Collapsed"/><Setter TargetName="Symbol" Property="Stroke" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SwitchFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MuteSwitch" TargetType="CheckBox" BasedOn="{StaticResource EffectSwitch}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="SwitchFrame" Background="#203045" BorderBrush="#34475F" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal">
          <Grid Width="18" Height="18" Margin="0,0,6,0"><Path Data="{TemplateBinding Tag}" Stroke="{StaticResource Accent}" StrokeThickness="1.8" Stretch="Uniform" Margin="2"/><Path x:Name="OffSlash" Visibility="Collapsed" Data="M 1,17 L 17,1" Stroke="#FF747C" StrokeThickness="2.2"/></Grid>
          <ContentPresenter VerticalAlignment="Center"/>
        </StackPanel></Border><ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="OffSlash" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SwitchFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="16"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedInk}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/></Style>
  </Application.Resources>
</Application>
