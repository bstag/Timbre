<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Timbre.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Timbre.App.MainWindow" Title="Timbre" Width="1100" Height="780" MinWidth="920" MinHeight="650" Background="#0E1725" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen">
  <Grid Margin="22" Background="#0E1725">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Timbre" FontSize="27" FontWeight="SemiBold" />
        <TextBlock x:Name="Subtitle" Text="Your devices. Your settings." Style="{StaticResource Caption}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="DiagnosticsButton" Style="{StaticResource HeaderIconButton}" Tag="{StaticResource DiagnosticsIcon}" Click="ExportClick" ToolTip="Export diagnostics" AutomationProperties.Name="Export diagnostics" Margin="0,0,6,0" />
        <Button x:Name="RefreshDevicesButton" Style="{StaticResource HeaderIconButton}" Tag="{StaticResource RefreshIcon}" Click="RefreshClick" ToolTip="Refresh devices" AutomationProperties.Name="Refresh devices" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="14" Margin="0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="CONNECTED DEVICES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="DeviceCount" Style="{StaticResource Caption}" Margin="0,8,0,12" />
            <Expander x:Name="SetupProfilesExpander" Header="Setup profiles" IsExpanded="False" Margin="0,0,0,12">
              <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,10,6,0">
                  <TextBlock Text="Save microphone and sound settings together." Style="{StaticResource Caption}" Margin="0,0,0,10" />
                  <Expander x:Name="SetupDevicesExpander" Header="Devices to include" IsExpanded="False">
                    <StackPanel Margin="0,10,0,0">
                      <ItemsControl x:Name="SetupDevices">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                              <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False" ToolTip="Check or clear all listed pages for this device">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                              </CheckBox>
                              <TextBlock Text="{Binding SelectionInfo}" Style="{StaticResource Caption}" Margin="22,4,0,8" />
                              <ItemsControl ItemsSource="{Binding Pages}" Margin="22,0,0,0">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8">
                                      <TextBlock Text="{Binding PageLabel}" TextWrapping="Wrap" />
                                    </CheckBox>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Content="Select edited pages" Click="SelectEditedSetupPagesClick" Margin="0,0,0,10" ToolTip="Select pages with direct adjustments successfully applied in this app session" />
                      <TextBlock Text="Check a device for all listed pages, or choose Sound or Microphone. Unchecked pages are left untouched. Save inclusion changes first." Style="{StaticResource Caption}" />
                    </StackPanel>
                  </Expander>
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SetupName" Text="Gaming" MaxLength="80" ToolTip="Setup name, for example Gaming, Meeting or Streaming" />
                    <Button Grid.Column="1" x:Name="SaveSetupAsButton" Content="Save as" Click="SaveSetupClick" Margin="6,0,0,0" />
                  </Grid>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SetupList" AutomationProperties.Name="Setup profile" DisplayMemberPath="Name" SelectionChanged="SetupSelectionChanged" ToolTip="Choose a saved setup" />
                    <Button Grid.Column="1" x:Name="ApplySetupButton" Content="Apply" Click="ApplySetupClick" IsEnabled="False" Margin="6,0,0,0" />
                  </Grid>
                  <Button x:Name="SaveSelectedSetupButton" Content="Save to selected setup" Click="SaveSelectedSetupClick" IsEnabled="False" HorizontalAlignment="Right" Margin="0,10,0,0" />
                  <TextBlock x:Name="SetupSummary" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                  <TextBlock x:Name="SetupResult" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                  <Button Content="Reload setups" Click="ReloadSetupsClick" HorizontalAlignment="Right" Margin="0,10,0,0" />
                  <TextBlock Text="Settings only. Select input and output devices in Windows or your apps." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
              </ScrollViewer>
            </Expander>
          </StackPanel>
          <ListBox x:Name="DeviceList" SelectionChanged="DeviceSelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Template>
              <!-- The native ListBox chrome paints white when disabled, regardless of its background. -->
              <ControlTemplate TargetType="ListBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                  <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <!-- Preserve text color when USB guards disable selection; native theme defaults dim it. -->
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="Padding" Value="10,14" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Frame" Background="#203045" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Frame" Property="Background" Value="#304D61" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Frame" Property="Opacity" Value="0.8" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Direction}" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,7,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="DetailScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="DetailPanel" IsEnabled="False">
          <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <DockPanel>
                <StackPanel x:Name="DevicePageNavigation" DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                  <Button x:Name="SoundPageButton" Content="Sound" Click="SoundPageClick" Margin="0,0,6,0" />
                  <Button x:Name="MicrophonePageButton" Content="Microphone" Click="MicrophonePageClick" />
                </StackPanel>
                <TextBlock x:Name="DeviceTitle" Text="Connect an EPOS device" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
              </DockPanel>
              <DockPanel x:Name="DraftControls" Margin="0,8,0,0">
                <CheckBox x:Name="LiveApplyCheck" Content="Apply live" IsChecked="True" Checked="LiveApplyChanged" Unchecked="LiveApplyChanged" DockPanel.Dock="Right" Margin="10,0,0,0" />
                <Button x:Name="DiscardChangesButton" Content="Discard edits" Click="DiscardChangesClick" DockPanel.Dock="Right" Margin="8,0,0,0" />
                <TextBlock x:Name="DraftInfo" Text="Settings are up to date." Style="{StaticResource Caption}" VerticalAlignment="Center" />
              </DockPanel>
              <StackPanel x:Name="VolumeControls" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="MuteCheck" Style="{StaticResource MuteSwitch}" Content="Audio" Tag="{StaticResource MicIcon}" ToolTip="Mute or unmute only this selected audio endpoint" AutomationProperties.Name="Mute this endpoint" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <DockPanel>
                      <TextBlock x:Name="LevelValue" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="16" />
                      <TextBlock x:Name="LevelTitle" Text="Microphone level" FontSize="13" />
                    </DockPanel>
                    <Slider x:Name="LevelSlider" ToolTip="{Binding Text, ElementName=LiveInfo}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LevelChanged" Margin="0,4,0,0" AutomationProperties.Name="Selected endpoint level" />
                  </StackPanel>
                  <Button Grid.Column="2" x:Name="ApplyButton" Content="Apply level" Click="ApplyClick" Margin="10,0,0,0" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="PlaybackCard" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
            <StackPanel>
              <DockPanel>
                <CheckBox x:Name="PlaybackMonitorEnabledCheck" Content="Live activity" DockPanel.Dock="Right" Checked="PlaybackMonitorChanged" Unchecked="PlaybackMonitorChanged" ToolTip="Analyze audio playing through this output. No recording is saved." />
                <TextBlock Text="Sound studio" FontSize="18" FontWeight="SemiBold" />
              </DockPanel>
              <ComboBox x:Name="SoundMode" AutomationProperties.Name="Playback sound mode" SelectionChanged="SoundModeChanged" Margin="0,12,0,12">
                <ComboBoxItem Content="Stereo (2.0)" />
                <ComboBoxItem Content="Virtual 7.1 surround" />
              </ComboBox>
              <TextBlock x:Name="PlaybackMonitorLevels" Text="No live audio values" Style="{StaticResource Caption}" FontSize="11" ToolTip="{Binding Text, ElementName=PlaybackMonitorStatus}" />
              <ProgressBar x:Name="PlaybackMonitorLevel" Minimum="-90" Maximum="0" Value="-90" Height="4" Background="#314154" Foreground="#5CA8F0" Margin="0,5,0,8" />
              <local:MicrophoneActivityView x:Name="PlaybackActivity" SourceLabel="Playback" Margin="0,0,0,6" />
              <Grid x:Name="ReverbControls" Margin="0,2,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox x:Name="ReverbEnabledCheck" Style="{StaticResource EffectSwitch}" Content="Reverb" Tag="{StaticResource ReverbIcon}" AutomationProperties.Name="Enable GSX reverb" ToolTip="Switch reverb on or off; the amount is kept. Available in virtual 7.1." Checked="ReverbToggleChanged" Unchecked="ReverbToggleChanged" />
                <Slider Grid.Column="1" x:Name="ReverbSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ReverbAmountChanged" Margin="12,0" VerticalAlignment="Center" AutomationProperties.Name="GSX reverb amount percent" />
                <TextBlock Grid.Column="2" x:Name="ReverbValue" Text="0%" MinWidth="35" Foreground="{StaticResource Accent}" VerticalAlignment="Center" ToolTip="Stored reverb amount; retained when switched off" />
              </Grid>
              <Expander x:Name="PlaybackEqExpander" Header="Playback equalizer" IsExpanded="False" Margin="0,0,0,12">
                <StackPanel Margin="0,12,0,0">
                  <UniformGrid x:Name="PlaybackEqBands" Columns="9" />
                  <Button Content="Reset curve to Flat" Click="FlatPlaybackEqClick" HorizontalAlignment="Right" Margin="0,12,0,0" />
                  <TextBlock Text="Nine bands · -6 to +6 dB. Adjustments apply automatically while live changes are on." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
              </Expander>
              <Button x:Name="ApplyPlaybackButton" Content="Apply sound settings" Click="ApplyPlaybackClick" HorizontalAlignment="Right" />
              <TextBlock x:Name="PlaybackInfo" Style="{StaticResource Caption}" Margin="0,10,0,0" />
              <TextBlock x:Name="PlaybackMonitorStatus" Text="Live activity is optional. EQ settings remain visible." Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" />
              <TextBlock Text="Uses the installed EPOS processor. Headphones stay connected to the GSX 300." Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Border x:Name="MicrophoneMonitorCard" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
            <Expander x:Name="MicrophoneMonitorExpander" Header="Microphone studio" IsExpanded="True" Collapsed="MonitorCollapsed">
              <StackPanel Margin="0,8,0,0">
                <DockPanel>
                  <CheckBox x:Name="MonitorEnabledCheck" Content="Live activity" Checked="MonitorChanged" Unchecked="MonitorChanged" DockPanel.Dock="Right" ToolTip="Analyze the selected microphone. No recordings are saved." />
                  <TextBlock x:Name="MonitorLevels" ToolTip="{Binding Text, ElementName=MonitorStatus}" Text="No live audio values" Style="{StaticResource Caption}" FontSize="11" />
                </DockPanel>
                <ProgressBar x:Name="MonitorLevel" Minimum="-90" Maximum="0" Value="-90" Height="4" Foreground="#5CA8F0" Background="#203045" Margin="0,6,0,0" />
                <local:MicrophoneActivityView x:Name="MicrophoneActivity" Margin="0,8,0,0" />
                <Border x:Name="EffectsCard" Visibility="Collapsed">
                  <StackPanel>
                    <StackPanel x:Name="MicrophoneProcessingEditors">
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="GateEnabledCheck" Style="{StaticResource EffectSwitch}" Content="Noise gate" Tag="{StaticResource GateIcon}" AutomationProperties.Name="Enable noise gate" ToolTip="Switch gating on or off; your level is kept. Hover or focus for its visual guide." MouseEnter="GateGuideEnter" MouseLeave="GateGuideLeave" GotKeyboardFocus="GateGuideEnter" LostKeyboardFocus="GateGuideLeave" Checked="ProcessingToggleChanged" Unchecked="ProcessingToggleChanged" />
                        <Slider Grid.Column="1" x:Name="GateSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding IsChecked, ElementName=GateEnabledCheck}" ValueChanged="EffectsChanged" Margin="12,0" VerticalAlignment="Center" AutomationProperties.Name="Noise gate level percent" MouseEnter="GateGuideEnter" MouseLeave="GateGuideLeave" GotKeyboardFocus="GateGuideEnter" LostKeyboardFocus="GateGuideLeave" />
                        <TextBlock Grid.Column="2" x:Name="GateValue" Text="0%" MinWidth="35" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                      </Grid>
                      <WrapPanel>
                        <CheckBox x:Name="FilterEnabledCheck" Style="{StaticResource EffectSwitch}" Content="Noise filter" Tag="{StaticResource FilterIcon}" AutomationProperties.Name="Enable noise filter" ToolTip="Switch filtering on or off. Level 0 is a preset, not off." Checked="ProcessingToggleChanged" Unchecked="ProcessingToggleChanged" Margin="0,0,6,6" />
                        <ComboBox x:Name="FilterLevel" Width="86" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=FilterEnabledCheck}" SelectionChanged="FilterChanged" AutomationProperties.Name="Noise filter level" Margin="0,0,8,6">
                          <ComboBoxItem Content="Level 0" />
                          <ComboBoxItem Content="Level 1" />
                          <ComboBoxItem Content="Level 2" />
                        </ComboBox>
                        <CheckBox x:Name="HighPassCheck" Style="{StaticResource EffectSwitch}" Content="High-pass" Tag="{StaticResource HighPassIcon}" AutomationProperties.Name="High-pass filter" ToolTip="Reduce low-frequency rumble" Checked="ProcessingToggleChanged" Unchecked="ProcessingToggleChanged" Margin="0,0,8,6" />
                        <CheckBox x:Name="EqEnabledCheck" Style="{StaticResource EffectSwitch}" Content="EQ" Tag="{StaticResource EqIcon}" AutomationProperties.Name="Enable microphone EQ" ToolTip="Switch equalization on or off; your curve is kept." Checked="ProcessingToggleChanged" Unchecked="ProcessingToggleChanged" Margin="0,0,6,6" />
                        <ComboBox x:Name="EqPreset" Width="86" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=EqEnabledCheck}" SelectionChanged="EqPresetChanged" AutomationProperties.Name="Microphone EQ preset" Margin="0,0,0,6">
                          <ComboBoxItem Content="Flat" />
                          <ComboBoxItem Content="Warm" />
                          <ComboBoxItem Content="Clear" />
                          <ComboBoxItem Content="Custom" />
                        </ComboBox>
                      </WrapPanel>
                      <Expander x:Name="MicrophoneEqExpander" Header="Adjust EQ bands" IsExpanded="False" FontSize="13">
                        <StackPanel Margin="0,8,0,0">
                          <UniformGrid x:Name="EqBands" Columns="9" IsEnabled="{Binding IsChecked, ElementName=EqEnabledCheck}" />
                          <TextBlock Text="Nine bands · -6 to +6 dB. Click a graph band to jump here." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                      </Expander>
                      <Button x:Name="ApplyEffectsButton" Content="Apply processing" Click="ApplyEffectsClick" HorizontalAlignment="Right" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="EffectsInfo" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" ToolTip="Readback from the installed processor" />
                  </StackPanel>
                </Border>
                <Border x:Name="SidetoneCard" Visibility="Collapsed" Margin="0,8,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox x:Name="SidetoneMuteCheck" Style="{StaticResource MuteSwitch}" Content="Sidetone" Tag="{StaticResource HeadphoneIcon}" AutomationProperties.Name="Mute sidetone" ToolTip="Hear your microphone through headphones connected to B20. Click to mute monitoring only." Checked="SidetoneMuteChanged" Unchecked="SidetoneMuteChanged" Margin="0,0,12,0" />
                      <Slider Grid.Column="1" x:Name="SidetoneSlider" Minimum="-34.5" Maximum="9" TickFrequency="0.5" IsSnapToTickEnabled="False" ValueChanged="SidetoneLevelChanged" VerticalAlignment="Center" AutomationProperties.Name="Sidetone level dB" />
                      <TextBlock Grid.Column="2" x:Name="SidetoneValue" MinWidth="70" TextAlignment="Right" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </Grid>
                    <Button x:Name="ApplySidetoneButton" Content="Apply sidetone" Click="ApplySidetoneClick" HorizontalAlignment="Right" Margin="0,6,0,0" />
                  </StackPanel>
                </Border>
                <Border x:Name="GsxSidetoneCard" Visibility="Collapsed" Margin="0,8,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Headphone monitoring through GSX 300. This controls level; a separate hardware mute is not mapped.">
                        <Path Data="{StaticResource HeadphoneIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource Accent}" Margin="0,0,6,0" />
                        <TextBlock Text="Sidetone" />
                      </StackPanel>
                      <Slider Grid.Column="1" x:Name="GsxSidetoneSlider" Minimum="0" Maximum="100" ValueChanged="GsxSidetoneLevelChanged" VerticalAlignment="Center" AutomationProperties.Name="GSX sidetone level percent" ToolTip="Monitoring level for headphones connected to the GSX 300. Percent follows the Suite scale; minimum is not a separate mute." />
                      <TextBlock Grid.Column="2" x:Name="GsxSidetoneValue" MinWidth="60" TextAlignment="Right" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="GsxSidetoneStatus" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed" />
                    <Button x:Name="ApplyGsxSidetoneButton" Content="Apply sidetone" Click="ApplyGsxSidetoneClick" HorizontalAlignment="Right" Margin="0,6,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Expander>
          </Border>
          <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Expander x:Name="ProfilesExpander" Header="Device profiles" IsExpanded="False">
              <StackPanel Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ProfileName" Text="Everyday" MaxLength="80" />
                  <Button Grid.Column="1" Content="Save as profile" Click="SaveProfileClick" Margin="8,0,0,0" />
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="ProfileList" AutomationProperties.Name="Device profile" DisplayMemberPath="Name" SelectionChanged="ProfileSelectionChanged" />
                  <Button Grid.Column="1" Content="Apply profile" Click="ApplyProfileClick" Margin="8,0,0,0" />
                </Grid>
                <Button x:Name="SaveSelectedProfileButton" Content="Save to selected profile" Click="SaveSelectedProfileClick" IsEnabled="False" HorizontalAlignment="Right" Margin="0,10,0,0" />
                <TextBlock Text="Profiles are saved for this device and audio page. Live adjustments change a profile only when you save. Manual drafts are excluded." Style="{StaticResource Caption}" Margin="0,10,0,0" />
              </StackPanel>
            </Expander>
          </Border>
          <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Expander x:Name="FeaturesExpander" Header="Device details and feature support" IsExpanded="False">
              <StackPanel>
                <TextBlock x:Name="DeviceInfo" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                <TextBlock x:Name="FormatInfo" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                <TextBlock x:Name="PickupPatternInfo" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="FeatureNote" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" Margin="0,6,0,0" />
                <CheckBox x:Name="SelectedSetupDeviceIncludeCheck" Content="Include whole device in setup" IsThreeState="False" Checked="SelectedSetupDeviceIncludeChanged" Unchecked="SelectedSetupDeviceIncludeChanged" Margin="0,12,0,0" ToolTip="Check or clear all listed Sound and Microphone pages for this physical device" />
                <CheckBox x:Name="SelectedSetupIncludeCheck" Content="Include this page in setup" Checked="SelectedSetupIncludeChanged" Unchecked="SelectedSetupIncludeChanged" Margin="0,8,0,0" />
                <ItemsControl x:Name="FeatureList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,10,0,4">
                        <DockPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Right" />
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="LiveInfo" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0" />
                <TextBlock x:Name="SidetoneInfo" Visibility="{Binding Visibility, ElementName=SidetoneCard}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0" />
                <TextBlock x:Name="GsxSidetoneInfo" Visibility="{Binding Visibility, ElementName=GsxSidetoneCard}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0" />
                <Expander x:Name="GsxProcessingExpander" Header="Saved device processing" Visibility="Collapsed" IsExpanded="False" FontSize="13" Margin="0,8,0,0">
                  <StackPanel>
                    <TextBlock x:Name="SavedGsxProcessingInfo" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBlock Text="Both Microphone and Sound: gate, filter, EQ, stereo/7.1 and reverb. Volume, mute and sidetone stay separate." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <CheckBox x:Name="RestoreGsxProcessingCheck" Content="Restore when this GSX connects or Timbre starts" Checked="RestoreGsxProcessingChanged" Unchecked="RestoreGsxProcessingChanged" Margin="0,8,0,0" />
                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                      <Button x:Name="SaveGsxProcessingButton" Content="Save current processing" Click="SaveGsxProcessingClick" ToolTip="Save applied microphone and sound settings together; manual drafts are excluded" Margin="0,0,8,8" />
                      <Button x:Name="RestoreGsxProcessingButton" Content="Restore saved processing" Click="RestoreGsxProcessingClick" ToolTip="Restore both microphone and sound processing for this GSX" Margin="0,0,0,8" />
                    </WrapPanel>
                  </StackPanel>
                </Expander>
                <Expander x:Name="GsxHelperExpander" Header="Experimental helper check" Visibility="Collapsed" IsExpanded="False" FontSize="13" Margin="0,8,0,0">
                  <StackPanel>
                    <TextBlock Text="Temporarily stops EPOS support, checks both GSX processing pages, then restores starting controls and service state. Keep other controllers idle. Requires administrator approval; Windows Audio stays running." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBlock x:Name="GsxHelperInfo" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <CheckBox x:Name="GsxHelperReconnectCheck" Content="Include GSX unplug/replug check" Margin="0,8,0,0" />
                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                      <Button x:Name="RunGsxHelperButton" Content="Run helper check" Click="RunGsxHelperClick" ToolTip="Open the bounded administrator check; follow its prompts and keep GSX connected through recovery" Margin="0,0,8,8" />
                      <Button x:Name="OpenGsxHelperReportsButton" Content="Open reports" Click="OpenGsxHelperReportsClick" IsEnabled="False" Margin="0,0,0,8" />
                    </WrapPanel>
                  </StackPanel>
                </Expander>
                <Expander x:Name="MicrophoneProcessingExpander" Visibility="{Binding Visibility, ElementName=MicrophoneMonitorCard}" Header="Monitor &amp; restore details" IsExpanded="False" FontSize="13" Margin="0,8,0,0">
                  <StackPanel>
                    <TextBlock x:Name="MonitorStatus" Text="Enable live activity to analyze your microphone. No recordings are saved." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBlock Text="One plot: blue activity uses the left dBFS axis; EQ uses the right dB gain axis. The amber gate guide uses the activity axis and is not a calibrated threshold." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <StackPanel x:Name="SavedProcessingPanel" Visibility="Collapsed" Margin="0,8,0,0">
                      <TextBlock x:Name="SavedProcessingInfo" Style="{StaticResource Caption}" />
                      <CheckBox x:Name="RestoreProcessingCheck" Content="Restore processing when this B20 connects or the app starts" Checked="RestoreProcessingChanged" Unchecked="RestoreProcessingChanged" Margin="0,8,0,0" />
                      <Button x:Name="RestoreProcessingButton" Content="Restore saved processing" Click="RestoreProcessingClick" HorizontalAlignment="Right" Margin="0,8,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock x:Name="Status" Grid.Row="2" Text="Starting…" Style="{StaticResource Caption}" Margin="0,12,0,0" />
  </Grid>
</Window>
